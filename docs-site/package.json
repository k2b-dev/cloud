{
  "name": "@k2b/cloud-docs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:ui": "bun run --cwd ../packages/ui build",
    "check:api-surface": "bun ./scripts/check-api-surface.ts",
    "check:docs": "bun ./scripts/check-documentation.ts",
    "check:example-coverage": "bun ./scripts/check-example-coverage.ts",
    "check:harness": "bun test ./scripts",
    "check:skills": "bun ../scripts/check-skills.ts",
    "precheck:ui-catalog": "bun run build:ui",
    "check:ui-catalog": "bun ./scripts/check-ui-catalog.ts",
    "precheck:ui-catalog:http": "bun run build:ui",
    "check:ui-catalog:http": "bun ./scripts/check-ui-catalog.ts --require-http",
    "predev": "bun run build:ui",
    "dev": "bun --watch --preload ./src/preload.ts ./src/dev.ts",
    "pretypecheck": "bun run build:ui",
    "typecheck": "tsc -p ./tsconfig.json --noEmit --pretty false",
    "pretypecheck:examples": "bun run build:ui",
    "typecheck:examples": "tsc -p ./examples/cloud-docs/tsconfig.json --noEmit --pretty false",
    "prebuild": "bun run build:ui",
    "build": "NODE_ENV=production bun ./src/build.ts",
    "start": "bun dist/server.js",
    "verify:docs": "bun run check:docs && bun run check:api-surface && bun run check:example-coverage && bun run check:skills && bun run check:ui-catalog && bun run check:harness && bun run typecheck && bun run typecheck:examples && CLOUD_DOCS_SITE_URL=http://localhost:3000 bun run build"
  },
  "dependencies": {
    "@hono/standard-validator": "0.2.2",
    "@k2b/fibel": "0.7.4",
    "@k2b/ssr": "catalog:",
    "@k2b/stdlib": "catalog:",
    "@k2b/ui": "workspace:*",
    "@k2b/cloud": "workspace:*",
    "hono": "catalog:",
    "hono-openapi": "catalog:",
    "solid-js": "catalog:",
    "zod": "catalog:",
    "@k2b/sync": "catalog:",
    "seroval": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "bun-plugin-tailwind": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.3.14"
}
