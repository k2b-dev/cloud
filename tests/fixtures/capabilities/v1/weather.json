    {
      "localId": "location.list",
      "title": "List my saved weather locations",
      "description": "Normal entry for browsing all saved locations. Use returned weather.location refs or IDs with location.read, forecast.current, or forecast.get; use location.search to filter by name or state.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "limit": {
            "default": 20,
            "description": "Maximum number of saved locations to return.",
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "cursor": {
            "description": "Opaque cursor returned by a previous location.list call.",
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        },
        "additionalProperties": false
      },
      "dataSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "maxItems": 100,
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[0-9A-Za-z]{6}$"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "state": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                {
                  "type": "null"
                }
              ]
            },
            "lat": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "lon": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            },
            "links": {
              "minItems": 1,
              "maxItems": 10,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "rel": {
                    "type": "string",
                    "enum": [
                      "open",
                      "edit",
                      "status",
                      "preview",
                      "download"
                    ],
                    "description": "Semantic relationship; clients decide how to present it."
                  },
                  "href": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2048,
                    "pattern": "^\\/(?![\\\\/])[^\\\\\\u0000-\\u001f\\u007f]*$",
                    "description": "Root-relative Cloud URL."
                  },
                  "title": {
                    "description": "Optional human-readable link label.",
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  }
                },
                "required": [
                  "rel",
                  "href"
                ],
                "additionalProperties": false
              }
            },
            "ref": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "const": "weather.location"
                },
                "id": {
                  "type": "string",
                  "pattern": "^[0-9A-Za-z]{6}$"
                }
              },
              "required": [
                "type",
                "id"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "id",
            "name",
            "state",
            "lat",
            "lon",
            "ref"
          ],
          "additionalProperties": false
        }
      },
      "schemaHash": "00ba8fa325f055c9f72373b041ebf70acfb9f84dd56906a4dfc6580eedc47f46",
      "openWorld": false
    },
