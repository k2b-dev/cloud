{
  "protocolVersion": 1,
  "appId": "weather",
  "manifestHash": "1c206b45523d1446f15328310da92a2679915bd883e578dc774c5e8e94df92f3",
  "types": [
    {
      "localId": "location",
      "title": "Saved location",
      "description": "A saved weather location owned by the current user.",
      "icon": "ti ti-map-pin",
      "reader": "location.read"
    }
  ],
  "queries": [
    {
      "localId": "city.search",
      "title": "Search German cities",
      "description": "Specialized geocoding path: find German city candidates and coordinates. To save one, copy the chosen name, optional state, lat, and lon into Save weather location; city results are not weather.location refs.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120,
            "description": "German city name to geocode; this searches city candidates, not saved locations."
          },
          "limit": {
            "default": 10,
            "description": "Maximum number of city candidates to return.",
            "type": "integer",
            "minimum": 1,
            "maximum": 25
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false
      },
      "dataSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "maxItems": 25,
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "lat": {
              "type": "number",
              "minimum": -90,
              "maximum": 90
            },
            "lon": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            },
            "country": {
              "type": "string",
              "minLength": 1,
              "maxLength": 16
            },
            "state": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            }
          },
          "required": [
            "name",
            "lat",
            "lon"
          ],
          "additionalProperties": false
        }
      },
      "schemaHash": "85746af15d349aa4f482b965fed72dcf34bd3864268a79ed630856c79a377d9a",
      "openWorld": true
    },
    {
      "localId": "forecast.current",
      "title": "Get current weather",
      "description": "Get current conditions for a saved location ID from location.list/search or explicit coordinates from city.search. Use forecast.get when hourly or daily outlooks are needed. Units are °C, km/h, mm, hPa, and metres.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "source": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "saved",
                    "description": "Use a saved location owned by the current user."
                  },
                  "locationId": {
                    "type": "string",
                    "pattern": "^[0-9A-Za-z]{6}$",
                    "description": "Saved-location ID returned by saved-location search/list or a weather.location ref."
                  }
                },
                "required": [
                  "kind",
                  "locationId"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "coordinates",
                    "description": "Use explicit latitude and longitude."
                  },
                  "lat": {
                    "type": "number",
                    "minimum": -90,
                    "maximum": 90,
                    "description": "Latitude in decimal degrees from -90 to 90."
                  },
                  "lon": {
                    "type": "number",
                    "minimum": -180,
                    "maximum": 180,
                    "description": "Longitude in decimal degrees from -180 to 180."
                  }
                },
                "required": [
                  "kind",
                  "lat",
                  "lon"
                ],
                "additionalProperties": false
              }
            ],
            "description": "Saved location or explicit coordinates used for the forecast."
          }
        },
        "required": [
          "source"
        ],
        "additionalProperties": false
      },
      "dataSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "temperature": {
            "type": "number",
            "minimum": -100,
            "maximum": 70,
            "description": "Air temperature in degrees Celsius."
          },
          "icon": {
            "type": "string",
            "enum": [
              "clear-day",
              "clear-night",
              "partly-cloudy-day",
              "partly-cloudy-night",
              "cloudy",
              "fog",
              "wind",
              "rain",
              "sleet",
              "snow",
              "hail",
              "thunderstorm"
            ]
          },
          "cloudCover": {
            "type": "number",
            "minimum": 0,
            "maximum": 100,
            "description": "Cloud cover percentage from 0 to 100."
          },
          "windSpeed": {
            "type": "number",
            "minimum": 0,
            "maximum": 500,
            "description": "Wind speed in kilometres per hour."
          },
          "windGust": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 500
              },
              {
                "type": "null"
              }
            ],
            "description": "Wind gust speed in kilometres per hour."
          },
          "windDirection": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 360
              },
              {
                "type": "null"
              }
            ],
            "description": "Wind direction in degrees."
          },
          "humidity": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              {
                "type": "null"
              }
            ],
            "description": "Relative humidity percentage from 0 to 100."
          },
          "precipitation": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000,
            "description": "Precipitation in millimetres during the last hour."
          },
          "pressure": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 2000
              },
              {
                "type": "null"
              }
            ],
            "description": "Mean sea-level pressure in hectopascals."
          },
          "visibility": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 10000000
              },
              {
                "type": "null"
              }
            ],
            "description": "Visibility in metres."
          },
          "dewPoint": {
            "anyOf": [
              {
                "type": "number",
                "minimum": -100,
                "maximum": 70
              },
              {
                "type": "null"
              }
            ],
            "description": "Dew point in degrees Celsius."
          },
          "sunshine": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 60
              },
              {
                "type": "null"
              }
            ],
            "description": "Sunshine duration in minutes during the last hour."
          },
          "stationName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          }
        },
        "required": [
          "temperature",
          "icon",
          "cloudCover",
          "windSpeed",
          "windGust",
          "windDirection",
          "humidity",
          "precipitation",
          "pressure",
          "visibility",
          "dewPoint",
          "sunshine",
          "stationName",
          "timestamp"
        ],
        "additionalProperties": false
      },
      "schemaHash": "4cda8c8c645bf5d25dc18c05205b278b0f4ec8368769babb19cf969d55bb216d",
      "openWorld": true
    },
