{
  "name": "@k2b/cloud-app-grids",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "module": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./cli": "./src/cli.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "test": "bun test --path-ignore-patterns '**/*.behavior.test.*'",
    "test:dom": "bun scripts/test-dom.ts",
    "test:all": "bun scripts/verify.ts",
    "test:coverage": "bun test --path-ignore-patterns '**/*.behavior.test.tsx' --path-ignore-patterns '**/*.behavior.test.ts' --coverage --coverage-reporter=lcov --coverage-dir=coverage && bun run scripts/check-backend-coverage.ts coverage/lcov.info && bun run test:dom",
    "test:integration": "bun scripts/verify.ts"
  },
  "dependencies": {
    "@xmldom/xmldom": "0.9.12",
    "@bwip-js/generic": "4.11.4",
    "@k2b/ssr": "catalog:",
    "@k2b/stdlib": "catalog:",
    "@k2b/sync": "catalog:",
    "@k2b/ui": "workspace:*",
    "@k2b/cloud": "workspace:*",
    "decimal.js": "10.6.0",
    "hono": "catalog:",
    "hono-openapi": "catalog:",
    "ibantools": "4.5.4",
    "juice": "catalog:",
    "lean-qr": "catalog:",
    "libxml2-wasm": "0.7.2",
    "pdf-lib": "1.17.1",
    "postcss": "catalog:",
    "saxes": "6.0.0",
    "solid-js": "catalog:",
    "yaml": "catalog:",
    "zod": "catalog:",
    "zxing-wasm": "3.1.4"
  },
  "devDependencies": {
    "@stackforge-eu/factur-x": "1.4.1",
    "@nats-io/jetstream": "catalog:",
    "@types/bun": "catalog:",
    "playwright": "catalog:",
    "typescript": "catalog:",
    "@nats-io/transport-node": "catalog:"
  },
  "license": "AGPL-3.0-or-later"
}
