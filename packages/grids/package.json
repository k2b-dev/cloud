{
  "name": "@valentinkolb/cloud-app-grids",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "module": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./cli": "./src/cli.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false 2>&1 | grep -v node_modules | (! grep -q 'error TS')",
    "test": "bun test",
    "test:db": "GRIDS_DB_TEST=1 bun test --max-concurrency 1",
    "test:coverage": "GRIDS_DB_TEST=1 bun test --max-concurrency 1 --coverage --coverage-reporter=lcov --coverage-dir=coverage && bun run scripts/check-backend-coverage.ts coverage/lcov.info",
    "browser-smoke": "bun run scripts/browser-smoke.ts",
    "sql-boundary-smoke": "bun run scripts/sql-boundary-smoke.ts",
    "smoke": "bash scripts/smoke.sh",
    "soak:100k": "bun run scripts/soak-100k.ts",
    "load:prepare": "bun --env-file=../../.env run scripts/load-test.ts reset",
    "load:smoke": "bun --env-file=../../.env run scripts/load-test.ts run smoke",
    "load:test": "bun --env-file=../../.env run scripts/load-test.ts run load",
    "load:soak": "bun --env-file=../../.env run scripts/load-test.ts run soak",
    "load:stress": "bun --env-file=../../.env run scripts/load-test.ts run stress",
    "load:cleanup": "bun --env-file=../../.env run scripts/load-test.ts cleanup",
    "pdf-previews": "bun run scripts/render-document-template-previews.ts"
  },
  "dependencies": {
    "@bwip-js/generic": "4.11.1",
    "@k2b/ssr": "catalog:",
    "@k2b/stdlib": "catalog:",
    "@k2b/sync": "catalog:",
    "@k2b/ui": "workspace:*",
    "@stackforge-eu/factur-x": "1.2.0",
    "@valentinkolb/cloud": "workspace:*",
    "decimal.js": "10.6.0",
    "hono": "catalog:",
    "hono-openapi": "catalog:",
    "juice": "catalog:",
    "lean-qr": "catalog:",
    "postcss": "catalog:",
    "solid-js": "catalog:",
    "zod": "catalog:",
    "zxing-wasm": "3.1.2"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "playwright": "catalog:",
    "typescript": "catalog:"
  },
  "license": "AGPL-3.0-or-later"
}
