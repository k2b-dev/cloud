{
  "name": "@k2b/cloud-app-mail",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "module": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./cli": "./src/cli.ts",
    "./capability-contracts": "./src/capability-contracts.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "test": "bun --cwd=../.. test --path-ignore-patterns '**/*.behavior.test.*' packages/mail/src",
    "test:integration": "bun --cwd=../.. test --timeout 30000 --preload ./scripts/fixtures/test-infra.ts --preload ./packages/mail/test/integration-preload.ts packages/mail/src"
  },
  "dependencies": {
    "@k2b/cloud": "workspace:*",
