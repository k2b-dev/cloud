{
  "name": "@valentinkolb/cloud-app-mail",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "module": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./cli": "./src/cli.ts",
    "./capability-contracts": "./src/capability-contracts.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false 2>&1 | grep -v node_modules | (! grep -q 'error TS')",
    "test": "bun --cwd=../.. test packages/mail/src",
    "test:integration": "MAIL_INTEGRATION_TESTS=1 bun --cwd=../.. test --preload ./packages/mail/test/integration-preload.ts packages/mail/src",
    "test:connector": "bun --cwd=../.. test packages/mail/src/service/connectors/connector-conformance.integration.test.ts",
    "test:performance:100k": "MAIL_PERFORMANCE_TESTS=1 MAIL_PERFORMANCE_MESSAGE_COUNT=100000 bun --cwd=../.. test packages/mail/src/service/performance.integration.test.ts",
    "browser-smoke": "bun --env-file=../../.env run scripts/browser-smoke.ts"
  },
  "dependencies": {
    "@valentinkolb/cloud": "workspace:*",
    "@k2b/ui": "workspace:*",
    "@k2b/ssr": "catalog:",
    "@k2b/stdlib": "catalog:",
    "@k2b/sync": "catalog:",
    "@zone-eu/mailsplit": "5.4.14",
    "fast-xml-parser": "5.10.1",
    "hono": "catalog:",
    "hono-openapi": "catalog:",
    "html-to-text": "10.0.0",
    "imapflow": "1.6.5",
    "juice": "catalog:",
    "mailparser": "3.9.14",
    "nodemailer": "catalog:",
    "postcss": "catalog:",
    "postcss-selector-parser": "7.1.4",
    "sanitize-html": "catalog:",
    "seroval": "catalog:",
    "solid-js": "catalog:",
    "yaml": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/html-to-text": "9.0.4",
    "@types/mailparser": "3.4.6",
    "@types/nodemailer": "catalog:",
    "@types/sanitize-html": "catalog:",
    "playwright": "catalog:",
    "typescript": "catalog:"
  },
  "license": "AGPL-3.0-or-later"
}
