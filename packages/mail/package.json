    "@k2b/sync": "catalog:",
    "@zone-eu/mailsplit": "5.4.14",
    "fast-xml-parser": "5.10.1",
    "hono": "catalog:",
    "hono-openapi": "catalog:",
    "html-to-text": "10.0.1",
    "imapflow": "1.6.5",
    "juice": "catalog:",
    "mailparser": "3.9.16",
    "nodemailer": "catalog:",
    "postcss": "catalog:",
    "postcss-selector-parser": "7.1.4",
    "sanitize-html": "catalog:",
    "seroval": "catalog:",
    "solid-js": "catalog:",
    "yaml": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/html-to-text": "9.0.4",
    "@types/mailparser": "3.4.6",
    "@types/sanitize-html": "catalog:",
