{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@k2b/cloud": ["../cloud/src/index.ts"],
      "@k2b/cloud/server": ["../cloud/src/server/index.ts"],
      "@k2b/cloud/server/*": ["../cloud/src/server/*"],
      "@k2b/cloud/browser": ["../cloud/src/server/api-client.ts"],
      "@k2b/cloud/shared": ["../cloud/src/shared/index.ts"],
      "@k2b/cloud/services": ["../cloud/src/services/index.ts"],
      "@k2b/cloud/services/*": ["../cloud/src/services/*"],
      "@k2b/cloud/ssr": ["../cloud/src/ssr/index.ts"],
      "@k2b/cloud/ssr/*": ["../cloud/src/ssr/*"],
      "@k2b/cloud/config": ["../cloud/src/config/index.ts"],
      "@k2b/cloud/config/*": ["../cloud/src/config/*"],
      "@k2b/cloud/contracts": ["../cloud/src/contracts/index.ts"],
      "@k2b/cloud/contracts/*": ["../cloud/src/contracts/*"],
      "@k2b/cloud/api": ["../cloud/src/api/index.ts"],
      "@k2b/cloud/clients/core": ["../cloud/src/clients/core.ts"]
    }
  },
  "include": ["./src/**/*.ts", "./src/**/*.tsx", "../cloud/src/types/**/*.d.ts"],
  "exclude": ["./dist", "./node_modules"]
}
