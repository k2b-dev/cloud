{
  "name": "@k2b/cloud-app-chat",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "module": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --checkers 2 -p tsconfig.json --noEmit --pretty false",
    "test:part:workspace": "bun test --preload ../../scripts/fixtures/test-infra.ts --path-ignore-patterns '**/*.behavior.test.*' src/frontend/ChatWorkspace src/frontend/ChatPanel",
    "test:part:rest": "bun test --preload ../../scripts/fixtures/test-infra.ts --path-ignore-patterns '**/*.behavior.test.*' --path-ignore-patterns 'src/frontend/ChatWorkspace*' --path-ignore-patterns 'src/frontend/ChatPanel*'"
  },
  "dependencies": {
    "@k2b/cloud": "workspace:*",
    "@k2b/ssr": "workspace:*",
    "@k2b/stdlib": "workspace:*",
    "@k2b/ui": "workspace:*",
    "entities": "8.0.0",
    "hono": "catalog:",
    "hono-openapi": "catalog:",
    "marked": "18.1.3",
    "solid-js": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "playwright": "catalog:",
    "typescript": "catalog:"
  },
  "license": "AGPL-3.0-or-later"
}
