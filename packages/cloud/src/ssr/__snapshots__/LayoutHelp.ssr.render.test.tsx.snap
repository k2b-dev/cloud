exports[`Help server frames embedded reader 2`] = `"<div class="help-shell app-accent-scope flex min-h-0 flex-col bg-[var(--ui-surface-raised)] h-full" data-surface="embedded" style="--app-accent:#16a34a;--app-ink-light:#117f3a;--app-ink-dark:#3bb267;--app-selected-light:#eff9f2;--app-selected-dark:#122922;--app-selected-nav-light:#e8f6ed;--app-selected-nav-dark:#122d23"><!--$--><!--/--><!--$--><div data-scroll-fade-axis="vertical" data-orientation="vertical" data-scroll-fade-mode="both" class="k2b-scroll-area min-h-0 flex-1 p-4 sm:p-5 " ><article class="help-article" data-surface="embedded"><div class="help-article-layout"><div class="help-article-main"><header class="help-article-head" data-help-article-head><div class="help-article-head-copy"><!--$--><p class="help-article-path"><!--$--><!--/--><button type="button" class="help-article-path-link focus-ui">Help</button></p><!--/--><h3 tabindex="-1" class="help-article-title focus-ui">Share a Space</h3><!--$--><div class="k2b-content-markdown help-document help-article-lead"><p>Share the Space with your team.</p></div><!--/--><!--$--><ul class="help-article-facts" aria-label="About this article"><!--$--><li class="help-article-fact" data-fact="needs"><i class="ti ti-key" aria-hidden="true"></i><span><!--$-->You need<!--/--> <strong>Edit</strong></span></li><!--/--><!--$--><li class="help-article-fact" data-fact="steps"><i class="ti ti-list-numbers" aria-hidden="true"></i><span>2 steps</span></li><!--/--></ul><!--/--><!--$--><div class="help-article-tools"><!--$--><span class="k2b-dropdown "><!--$--><button aria-controls="k2b-dropdown-#1" aria-expanded="false" aria-haspopup="menu" aria-label="On this page" type="button" class="k2b-button  k2b-dropdown__trigger  " data-size="sm" data-variant="secondary" ><span class="k2b-button__label"><i class="ti ti-list" aria-hidden="true"></i><span>On this page</span><i class="ti ti-chevron-down" aria-hidden="true"></i></span><!--$--><!--/--></button><!--/--><div id="k2b-dropdown