    {
      "localId": "content.download",
      "title": "Get file download link",
      "description": "Request a direct single-file download lease only when the user downloads a filesv2.entry from listing or search. Rechecks current access. Returns a bearer URL valid for 60 seconds; never store it in a list or shared data. Use content.read for processing bytes in code.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "description": "Exact ID from a filesv2.entry ref returned by listing or search."
          }
        },
        "required": ["id"],
        "additionalProperties": false
      },
      "dataSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "description": "Private bearer URL from the download service. Use unchanged without Cloud credentials."
          },
          "method": { "type": "string", "const": "GET" },
          "expires": { "type": "string", "description": "Lease expiry timestamp returned by storage. Request a fresh lease after expiry." }
        },
        "required": ["url", "method", "expires"],
        "additionalProperties": false
      },
      "schemaHash": "0811b86f2bc2e69d792fc6003c8b4dc1167b5f8a74c6c56e5d29dcd43b630ff1",
      "openWorld": false
    },
    {
