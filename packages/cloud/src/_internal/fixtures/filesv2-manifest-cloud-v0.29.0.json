            "type": "array",
            "items": { "type": "string", "minLength": 1, "maxLength": 64 },
            "description": "Canonical search facets supported by this query."
          },
          "scope": {
            "description": "Optional resource containing the search results; must be an explicitly supported scope type.",
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "minLength": 3,
                "maxLength": 180,
                "pattern": "^[a-z][a-z0-9-]*\\.[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
                "description": "Namespaced resource type declared by the owning app."
              },
              "id": { "type": "string", "minLength": 1, "maxLength": 512, "description": "Stable app-owned resource identifier." }
            },
            "required": ["type", "id"],
            "additionalProperties": false
          },
          "limit": { "type": "integer", "minimum": 1, "maximum": 100, "description": "Maximum number of results to return." }
        },
        "required": ["query", "tags", "limit"],
        "additionalProperties": false
      },
      "dataSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "maxItems": 100,
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "ref": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "minLength": 3,
                  "maxLength": 180,
                  "pattern": "^[a-z][a-z0-9-]*\\.[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
                  "description": "Namespaced resource type declared by the owning app."
                },
                "id": { "type": "string", "minLength": 1, "maxLength": 512, "description": "Stable app-owned resource identifier." }
              },
              "required": ["type", "id"],
              "additionalProperties": false,
              "description": "Stable identity of the result."
            },
            "title": { "type": "string", "minLength": 1, "maxLength": 500, "description": "Primary result label." },
            "preview": { "description": "Short plain-text result preview.", "type": "string", "maxLength": 2000 },
            "icon": { "description": "Optional presentation icon.", "type": "string", "minLength": 1, "maxLength": 120 },
            "priority": { "description": "App-local relevance hint from zero to nine.", "type": "integer", "minimum": 0, "maximum": 9 },
            "metadata": {
              "description": "Small structured metadata shown with the result.",
              "maxItems": 20,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "label": { "type": "string", "minLength": 1, "maxLength": 120 },
                  "value": { "type": "string", "maxLength": 1000 }
                },
                "required": ["label", "value"],
                "additionalProperties": false
              }
            },
            "links": {
              "minItems": 1,
              "maxItems": 10,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "rel": {
                    "type": "string",
                    "enum": ["open", "edit", "status", "preview", "download"],
                    "description": "Semantic relationship; clients decide how to present it."
                  },
                  "href": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2048,
                    "pattern": "^\\/(?![\\\\/])[^\\\\\\u0000-\\u001f\\u007f]*$",
                    "description": "Root-relative Cloud URL."
                  },
                  "title": { "description": "Optional human-readable link label.", "type": "string", "minLength": 1, "maxLength": 120 }
                },
                "required": ["rel", "href"],
                "additionalProperties": false
              },
              "description": "Semantic links for the resource."
            }
          },
          "required": ["ref", "title", "links"],
          "additionalProperties": false
        }
