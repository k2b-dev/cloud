          },
          "size": { "type": "integer", "minimum": 0, "maximum": 52428800, "description": "Exact byte count of the new content." },
          "mediaType": {
            "default": "application/octet-stream",
            "description": "Media type of the binary payload.",
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "pattern": "^[\\x20-\\x7e]+$"
