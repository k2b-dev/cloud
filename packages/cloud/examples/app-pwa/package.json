{
  "name": "cloud-visit-demo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development APP_ID=visit-demo APP_DIR=. bun --preload=./node_modules/@k2b/cloud/scripts/preload.ts --watch src/index.ts",
    "build": "NODE_ENV=production APP_ID=visit-demo APP_DIR=. bun run node_modules/@k2b/cloud/scripts/build.ts",
    "start": "cd dist && NODE_ENV=production bun server.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@k2b/cloud": "0.41.0",
    "@k2b/ssr": "0.19.0",
    "@k2b/stdlib": "0.30.0",
    "@k2b/ui": "0.31.0",
    "hono": "4.13.9",
    "lean-qr": "2.7.2",
    "solid-js": "1.9.17",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "typescript": "7.0.2"
  }
}
