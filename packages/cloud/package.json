{
  "name": "@k2b/cloud",
  "version": "0.11.0",
  "description": "Application platform library for independently deployed Hono and SolidJS services behind a dynamic gateway.",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/k2b-dev/cloud.git",
    "directory": "packages/cloud"
  },
  "homepage": "https://github.com/k2b-dev/cloud",
  "bugs": "https://github.com/k2b-dev/cloud/issues",
  "type": "module",
  "files": [
    "src",
    "scripts",
    "public",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/*.integration.test.ts",
    "!src/**/*.test-fixture.ts",
    "!scripts/**/*.test.ts",
    "!scripts/runtime-recovery-*.ts"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./desktop": "./src/desktop/index.ts",
    "./desktop/solid": "./src/desktop/solid.tsx",
    "./server": "./src/server/index.ts",
    "./server/*": "./src/server/*",
    "./browser": "./src/server/api-client.ts",
    "./browser/app-approval": "./src/browser/app-approval.ts",
    "./browser/live": "./src/browser/live-websocket.ts",
    "./browser/mermaid": "./src/browser/mermaid.ts",
    "./browser/notifications": "./src/browser/notifications.ts",
    "./browser/resource-clipboard": "./src/browser/resource-clipboard.ts",
    "./browser/commands": "./src/browser/commands.ts",
    "./browser/search": "./src/browser/search.ts",
    "./browser/testing": "./src/browser/testing.ts",
    "./browser/resource-picker": "./src/browser/resource-picker.tsx",
    "./capabilities": "./src/capabilities/client.ts",
    "./capabilities/server": "./src/capabilities/server.ts",
    "./capabilities/store": "./src/capabilities/executions.ts",
    "./capabilities/testing": "./src/capabilities/testing.ts",
    "./cli": "./src/cli/index.ts",
    "./cli/access": "./src/cli/access.ts",
    "./cli/account": "./src/cli/account.ts",
    "./cli/apps": "./src/cli/apps.ts",
    "./cli/capabilities": "./src/cli/capabilities.ts",
    "./cli/admin": "./src/cli/admin/index.ts",
    "./shared": "./src/shared/index.ts",
    "./services": "./src/services/index.ts",
    "./services/document-extraction": "./src/services/document-extraction.ts",
    "./services/ipa/service-account": null,
    "./services/*": "./src/services/*",
    "./ai": "./src/ai/index.ts",
    "./ai/admin": "./src/ai/admin.ts",
    "./ai/browser": "./src/ai/browser.ts",
    "./ai/live": "./src/ai/live.ts",
    "./ai/live-events": "./src/ai/live-events.ts",
    "./ai/runtime": "./src/ai/runtime.ts",
    "./ai/solid": "./src/ai/solid.ts",
    "./ai/tools": "./src/ai/runtime-tools.ts",
    "./ai/ui": "./src/ai/ui.tsx",
    "./account/ui": "./src/account/ui.ts",
    "./access/ui": "./src/access/ui.ts",
    "./ssr": "./src/ssr/index.ts",
    "./ssr/islands": "./src/ssr/islands/index.ts",
    "./ssr/WorkspaceNavigation.island": "./src/ssr/WorkspaceNavigation.island.tsx",
    "./ssr/*": "./src/ssr/*",
    "./config": "./src/config/index.ts",
    "./config/*": "./src/config/*",
    "./contracts": "./src/contracts/index.ts",
    "./contracts/notifications": "./src/contracts/notification-types.ts",
    "./contracts/*": "./src/contracts/*",
    "./workflows": "./src/workflows/index.ts",
    "./workflows/ai": "./src/workflows/ai/index.ts",
    "./workflows/editor": "./src/workflows/editor.ts",
    "./workflows/language": "./src/workflows/language/index.ts",
    "./workflows/runtime": "./src/workflows/runtime/index.ts",
    "./workflows/store": "./src/workflows/store/index.ts",
    "./workflows/testing": "./src/workflows/testing/index.ts",
    "./api": "./src/api/index.ts",
    "./clients/core": "./src/clients/core.ts",
    "./styles/global.css": "./src/styles/global.css"
  },
  "scripts": {
    "test": "bun test --isolate --path-ignore-patterns '**/*.behavior.test.tsx' --path-ignore-patterns '**/*.dom.test.tsx' && bun run test:dom",
    "test:dom": "bun test --isolate --conditions=browser --preload ../ui/test/solid-dom-preload.ts behavior.test.tsx dom.test.tsx",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false"
  },
  "dependencies": {
    "@firecrawl/anydoc": "0.2.4",
    "@napi-rs/canvas": "1.0.9",
    "pdfjs-dist": "6.3.289",
    "@hono/standard-validator": "0.2.2",
    "@simplewebauthn/server": "14.0.2",
    "@tabler/icons": "3.47.0",
    "@tailwindcss/typography": "0.5.20",
    "@k2b/nessi": "0.12.1",
    "@k2b/ssr": "0.14.0",
    "@k2b/ui": "0.5.0",
    "@k2b/stdlib": "0.25.0",
    "@k2b/sync": "6.5.0",
    "@nats-io/transport-node": "3.4.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "bun-plugin-tailwind": "0.1.2",
    "hono-openapi": "1.3.1",
    "jose": "6.2.12",
    "katex": "0.18.7",
    "liquidjs": "10.29.0",
    "marked": "17.0.6",
    "mermaid": "12.0.0",
    "nodemailer": "10.0.10",
    "postcss": "8.5.28",
    "reflect-metadata": "0.2.2",
    "sanitize-html": "2.17.7",
    "seroval": "1.6.7",
    "tailwindcss": "4.3.3",
    "web-push": "3.6.7",
    "web-vitals": "6.2.2",
    "yaml": "2.9.1",
    "hash-wasm": "4.12.0",
    "@types/sanitize-html": "2.16.1",
    "@types/web-push": "3.6.4"
  },
  "devDependencies": {
    "@babel/core": "8.0.6",
    "@babel/preset-typescript": "8.0.1",
    "@types/bun": "1.4.2",
    "babel-preset-solid": "1.9.15",
    "hono": "4.13.8",
    "solid-js": "1.9.15",
    "typescript": "5.9.3",
    "zod": "4.6.5"
  },
  "peerDependencies": {
    "hono": "^4.12.25",
    "solid-js": "^1.9.10",
    "zod": "^4.3.4"
  }
}
