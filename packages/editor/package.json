{
  "name": "@k2b/editor",
  "version": "0.1.0",
  "description": "Configurable Markdown editor for SolidJS: editor, toolbar, bubble menu, and slash menu on one shared state.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "bun --cwd=../.. test --path-ignore-patterns '**/*.behavior.test.*' packages/editor/src",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false"
  },
  "peerDependencies": {
    "solid-js": "^1.9.10"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.10.4",
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.7",
    "@k2b/stdlib": "0.30.0",
    "@k2b/ui": "0.35.0"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "solid-js": "1.9.17",
    "typescript": "7.0.2"
  },
  "license": "AGPL-3.0-or-later",
  "author": "Valentin Kolb",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/k2b-dev/cloud.git",
    "directory": "packages/editor"
  },
  "homepage": "https://github.com/k2b-dev/cloud/tree/main/packages/editor",
  "bugs": "https://github.com/k2b-dev/cloud/issues",
  "keywords": [
    "solid",
    "solidjs",
    "editor",
    "markdown",
    "codemirror",
    "toolbar"
  ],
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  }
}
