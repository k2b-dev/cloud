{
  "name": "@k2b/editor",
  "version": "0.5.0",
  "description": "Configurable Markdown editor for SolidJS: editor, toolbar, bubble menu, and slash menu on one shared state.",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./markdown": "./src/markdown/index.ts",
    "./styles.css": "./src/styles.css",
    "./markdown/lib/*": "./src/markdown/lib/*.ts",
    "./markdown/urls": "./src/markdown/urls.ts",
    "./markdown/mermaid-render": "./src/markdown/mermaid-render.ts",
    "./markdown/mermaid-viewport": "./src/markdown/mermaid-viewport.tsx",
    "./markdown/inline-syntax": "./src/markdown/_lib/inline-syntax.ts",
    "./markdown/math-syntax": "./src/markdown/_lib/math-syntax.ts",
    "./markdown/fade-scroll-margins": "./src/markdown/fade-scroll-margins.ts",
    "./collab": "./src/collab/index.ts",
    "./formula": "./src/formula.ts",
    "./charts": "./src/charts.ts",
    "./markdown/pretty-table": "./src/markdown/pretty-table.ts",
    "./markdown/shared-tables": "./src/markdown/shared-tables.ts",
    "./markdown/pretty-table-messages": "./src/markdown/pretty-table-messages.ts",
    "./markdown/chart-copy": "./src/markdown/chart-copy.ts",
    "./markdown/notebook-charts": "./src/markdown/notebook-charts.tsx"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false"
  },
  "peerDependencies": {
    "solid-js": "^1.9.10",
    "y-codemirror.next": "^0.3.6",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33",
    "zod": "^4.3.4"
  },
  "peerDependenciesMeta": {
    "y-codemirror.next": {
      "optional": true
    },
    "y-protocols": {
      "optional": true
    },
    "yjs": {
      "optional": true
    }
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.10.4",
    "@codemirror/lang-cpp": "6.0.3",
    "@codemirror/lang-css": "6.3.1",
    "@codemirror/lang-go": "6.0.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-java": "6.0.2",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-php": "6.0.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/lang-rust": "6.0.2",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/lang-xml": "6.1.0",
    "@codemirror/lang-yaml": "6.1.3",
    "@codemirror/language": "6.12.4",
    "@codemirror/lint": "6.9.7",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.1",
    "@codemirror/view": "6.43.7",
    "@k2b/stdlib": "0.30.0",
    "@k2b/ui": "0.42.0",
    "@lezer/common": "1.5.3",
    "@lezer/highlight": "1.2.4",
    "@lezer/markdown": "1.7.2",
    "@uiw/codemirror-themes": "4.25.12",
    "katex": "0.18.9",
    "marked": "18.0.14",
    "mermaid": "12.0.0"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "solid-js": "1.9.17",
    "typescript": "7.0.2",
    "playwright": "1.64.1",
    "bun-plugin-tailwind": "0.1.2",
    "zod": "4.6.5",
    "y-codemirror.next": "0.3.6",
    "y-protocols": "1.0.7",
    "yjs": "13.6.33"
  },
  "license": "AGPL-3.0-or-later",
  "author": "Valentin Kolb",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/k2b-dev/cloud.git",
    "directory": "packages/editor"
  },
  "homepage": "https://github.com/k2b-dev/cloud/tree/main/packages/editor",
  "bugs": "https://github.com/k2b-dev/cloud/issues",
  "keywords": [
    "solid",
    "solidjs",
    "editor",
    "markdown",
    "codemirror",
    "toolbar"
  ],
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/*.fixture.ts",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  }
}
