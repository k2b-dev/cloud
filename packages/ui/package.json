{
  "name": "@k2b/ui",
  "version": "0.6.2",
  "description": "Production-ready components for SolidJS applications.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/k2b-dev/cloud.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/k2b-dev/cloud",
  "bugs": "https://github.com/k2b-dev/cloud/issues",
  "type": "module",
  "types": "./dist/types/index.d.ts",
  "sideEffects": [
    "./dist/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "browser": "./dist/browser/index.js",
      "import": "./dist/ssr/index.js",
      "default": "./dist/ssr/index.js"
    },
    "./global.css": "./dist/global.css",
    "./styles.css": "./dist/styles.css",
    "./fonts/plex.css": "./dist/plex.css",
    "./icons/tabler.css": "./dist/tabler.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "bun run scripts/build.ts",
    "check:declarations": "bun run scripts/check-declarations.ts",
    "fixture:build": "bun run build && NODE_ENV=production bun run fixture/scripts/build.ts",
    "fixture:typecheck": "tsc -p fixture/tsconfig.json --noEmit --pretty false",
    "test": "bun run build && bun test --path-ignore-patterns '**/*.behavior.test.*' src scripts && bun run scripts/check-packed-consumer.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false && bun run check:declarations && bun run typecheck:dom",
    "typecheck:dom": "tsc -p test/tsconfig.json --noEmit --pretty false",
    "prepack": "bun run build"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@k2b/stdlib": "0.26.0",
    "@tabler/icons-webfont": "3.46.0",
    "marked": "17.0.6"
  },
  "peerDependencies": {
    "@k2b/ssr": "^0.12.0 || ^0.13.0 || ^0.14.0",
    "solid-js": "^1.9.10"
  },
  "devDependencies": {
    "@babel/core": "8.0.6",
    "@babel/preset-typescript": "8.0.1",
    "@k2b/ssr": "0.14.0",
    "@types/babel__core": "7.20.5",
    "@types/bun": "1.4.2",
    "babel-preset-solid": "1.9.15",
    "bun-plugin-tailwind": "0.1.2",
    "happy-dom": "20.11.2",
    "hono": "4.13.8",
    "seroval": "1.6.7",
    "solid-js": "1.9.15",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "AGPL-3.0-or-later"
}
