{
  "text with label": "<div data-hk=\"0100\" class=\"k2b-field \"><!--$--><label data-hk=\"0101000\" id=\"number-label\" class=\"k2b-field__label\" for=\"number\"><!--$-->Invoice number<!--/--><!--$--><!--/--></label><!--/--><!--$--><!--/--><!--$--><div data-hk=\"0103\" class=\"k2b-input-shell k2b-text-input\" style=\"\"><!--$--><!--/--><!--$--><!--/--><!--$--><input data-hk=\"01060\" name=\"number\" placeholder=\"INV-…\" id=\"number\" class=\"k2b-input \" type=\"text\" value=\"\" aria-labelledby=\"number-label\" /><!--/--><!--$--><!--/--><!--$--><!--/--><!--$--><!--/--></div><!--/--><!--$--><!--/--></div>",
  "text search without label": "<div data-hk=\"0100\" class=\"k2b-field \"><!--$--><!--/--><!--$--><!--/--><!--$--><div data-hk=\"0103\" class=\"k2b-input-shell k2b-text-input\" style=\"\"><!--$--><span data-hk=\"01040\" class=\"k2b-input-shell__icon k2b-text-input__icon\" aria-hidden=\"true\"><i class=\"ti ti-search\"></i><i class=\"ti ti-search\"></i></span><!--/--><!--$--><!--/--><!--$--><input data-hk=\"01060\" placeholder=\"Search help\" id=\"search\" class=\"k2b-input \" type=\"search\" value=\"invoice\" aria-label=\"Search help\" /><!--/--><!--$--><!--/--><!--$--><button data-hk=\"01080\" type=\"button\" class=\"k2b-input-shell__clear k2b-input-clear-action\" aria-label=\"Clear\"><i class=\"ti ti-x\" aria-hidden=\"true\"></i></button><!--/--><!--$--><!--/--></div><!--/--><!--$--><!--/--></div>",
  "text multiline": "<div data-hk=\"0100\" class=\"k2b-field \"><!--$--><label data-hk=\"0101000\" id=\"text-label\" class=\"k2b-field__label\" for=\"text\"><!--$-->Booking text<!--/--><!--$--><!--/--></label><!--/--><!--$--><!--/--><!--$--><div data-hk=\"0103\" class=\"k2b-input-shell k2b-text-input\" data-multiline=\"true\" style=\"--k2b-editor-lines:2\"><!--$--><!--/--><!--$--><!--/--><!--$--><textarea data-hk=\"01060\" id=\"text\" class=\"k2b-input k2b-text-input__textarea \" value=\"Purchase\" rows=\"2\" aria-labelledby=\"text-label\" >\nPurchase</textarea><!--/--><!--$--><!--/--><!--$--><!--/--><!--$--><!--/--></div><!--/--><!--$--><!--/--></div>",
  "text required with description and error": "<div data-hk=\"0100\" class=\"k2b-field \" data-invalid=\"true\"><!--$--><label data-hk=\"0101000\" id=\"mail-label\" class=\"k2b-field__label\" for=\"mail\"><!--$-->Mail<!--/--><!--$--><span data-hk=\"01010010\" class=\"k2b-field__required\" aria-hidden=\"true\">*</span><!--/--></label><!--/--><!--$--><p data-hk=\"01020\" class=\"k2b-field__description\" id=\"mail-description\">Where the receipt goes.</p><!--/--><!--$--><div data-hk=\"0103\" class=\"k2b-input-shell k2b-text-input\" data-invalid=\"true\" style=\"\"><!--$--><!--/--><!--$--><!--/--><!--$--><input data-hk=\"01060\" autocapitalize=\"none\" autocorrect=\"off\" spellcheck=\"false\" id=\"mail\" class=\"k2b-input \" type=\"email\" value=\"\" required aria-labelledby=\"mail-label\" aria-describedby=\"mail-description mail-error\" aria-invalid=\"true\" aria-required=\"true\"/><!--/--><!--$--><!--/--><!--$--><!--/--><!--$--><!--/--></div><!--/--><!--$--><p data-hk=\"010a100\" class=\"k2b-field__error\" id=\"mail-error\" role=\"alert\" aria-live=\"polite\">Enter an address.</p><!--/--></div>",
  "number": "<div data-hk=\"010\" class=\"k2b-field \"><!--$--><label data-hk=\"011000\" id=\"gross-label\" class=\"k2b-field__label\" for=\"gross\"><!--$-->Gross amount<!--/--><!--$--><!--/--></label><!--/--><!--$--><!--/--><!--$--><div data-hk=\"013\" class=\"k2b-input-shell k2b-number-input\" data-appearance=\"field\"><!--$--><button data-hk=\"0140\" type=\"button\" class=\"k2b-number-input__step\" aria-label=\"Decrease value\"><i class=\"ti ti-minus\" aria-hidden=\"true\"></i></button><!--/--><div class=\"k2b-number-input__value\"><!--$--><!--/--><!--$--><!--/--><!--$--><input data-hk=\"0170\" id=\"gross\" class=\"k2b-input k2b-number-input__control \" data-filled=\"true\" type=\"text\" role=\"spinbutton\" inputmode=\"decimal\" value=\"321.40\" aria-labelledby=\"gross-label\" aria-valuenow=\"321.4\" aria-valuetext=\"321.40 €\" /><!--/--><!--$--><span data-hk=\"0180\" class=\"k2b-input-shell__affix\">€</span><!--/--><!--$--><!--/--></div><!--$--><button data-hk=\"01a100\" type=\"button\" class=\"k2b-number-input__step\" aria-label=\"Increase value\"><i class=\"ti ti-plus\" aria-hidden=\"true\"></i></button><!--/--></div><!--/--><!--$--><!--/--></div>",
  "number plain": "<div data-hk=\"010\" class=\"k2b-field \"><!--$--><!--/--><!--$--><!--/--><!--$--><div data-hk=\"013\" class=\"k2b-input-shell k2b-number-input\" data-appearance=\"plain\"><!--$--><!--/--><div class=\"k2b-number-input__value\"><!--$--><!--/--><!--$--><!--/--><!--$--><span data-hk=\"0170\" class=\"k2b-number-input__sizer\" data-value=\"\" data-placeholder=\"true\"><input data-hk=\"0171\" id=\"minutes\" class=\"k2b-input k2b-number-input__control \" type=\"text\" role=\"spinbutton\" inputmode=\"numeric\" value=\"\" aria-label=\"Minutes\" size=\"1\"/></span><!--/--><!--$--><!--/--><!--$--><!--/--></div><!--$--><!--/--></div><!--/--><!--$--><!--/--></div>",
  "date": "<div data-hk=\"00010\" class=\"k2b-field \"><!--$--><label data-hk=\"00011000\" id=\"date-label\" class=\"k2b-field__label\" for=\"date\"><!--$-->Invoice date<!--/--><!--$--><!--/--></label><!--/--><!--$--><!--/--><!--$--><div data-hk=\"00013\" class=\"k2b-date-picker k2b-date-field\"><div class=\"k2b-input-shell\"><span class=\"k2b-input-shell__icon k2b-date-field__icon\" aria-hidden=\"true\"><i class=\"ti ti-calendar\"></i></span><input aria-labelledby=\"date-label\" aria-describedby=\"date-error\" id=\"date\" class=\"k2b-input \" type=\"text\" inputMode=\"numeric\" autocomplete=\"off\" spellcheck=\"false\" role=\"combobox\" aria-haspopup=\"dialog\" aria-expanded=\"false\" aria-controls=\"date-calendar\" placeholder=\"MM/DD/YYYY\" value=\"10/28/2026\" /><!--$--><!--/--><!--$--><button data-hk=\"000150\" type=\"button\" class=\"k2b-date-field__toggle\" tabindex=\"-1\" aria-label=\"Open calendar\" aria-expanded=\"false\" aria-controls=\"date-calendar\"><i class=\"ti ti-chevron-down\" aria-hidden=\"true\"></i></button><!--/--><div id=\"date-calendar\" class=\"k2b-date-popover\" popover=\"manual\" role=\"dialog\" aria-label=\"Invoice date\"></div></div><!--$--><p data-hk=\"000170\" id=\"date-error\" class=\"k2b-date-status\" data-tone=\"rest\" title=\"Wednesday, 11 days ago\">Wednesday, 11 days ago</p><span data-hk=\"000171\" class=\"k2b-sr-only\" aria-live=\"polite\"></span><!--/--></div><!--/--><!--$--><!--/--></div>",
  "date plain": "<div data-hk=\"00010\" class=\"k2b-field \"><!--$--><label data-hk=\"00011000\" id=\"due-label\" class=\"k2b-field__label\" for=\"due\"><!--$-->Due<!--/--><!--$--><!--/--></label><!--/--><!--$--><!--/--><!--$--><div data-hk=\"00013\" class=\"k2b-date-picker\" data-appearance=\"plain\"><button id=\"due\" type=\"button\" class=\"k2b-date-trigger \" data-placeholder=\"true\" aria-haspopup=\"dialog\" aria-expanded=\"false\" aria-controls=\"due-popover\" aria-labelledby=\"due-label\" aria-describedby=\"due-value\" ><i class=\"ti ti-calendar k2b-date-trigger__icon\" aria-hidden=\"true\"></i><span id=\"due-value\" class=\"k2b-date-trigger__value\">Pick date</span><i class=\"ti ti-chevron-down k2b-date-trigger__chevron\" aria-hidden=\"true\"></i></button><!--$--><!--/--><div id=\"due-popover\" class=\"k2b-date-popover\" popover=\"auto\" role=\"dialog\" aria-label=\"Due\"><!--$--><div data-hk=\"00016\" class=\"k2b-date-popover__body\"><!--$--><!--/--><!--$--><!--/--></div><!--/--><!--$--><!--/--></div></div><!--/--><!--$--><!--/--></div>",
