  "switch without label": "<div data-hk=\"01\" class=\"k2b-switch-field \"><label class=\"k2b-switch\"><input id=\"deduct2\" type=\"checkbox\" role=\"switch\" aria-label=\"Deduct input VAT\" /><span class=\"k2b-switch__track\" aria-hidden=\"true\"><span class=\"k2b-switch__thumb\"></span></span><!--$--><!--/--></label><!--$--><!--/--><!--$--><!--/--></div>",
  "slider with label end": "<div data-hk=\"010\" class=\"k2b-field \"><!--$--><div data-hk=\"01103\" class=\"k2b-field__label-row\"><!--$--><label data-hk=\"011040\" id=\"contrast-label\" class=\"k2b-field__label\" for=\"contrast\"><!--$-->Contrast<!--/--><!--$--><!--/--></label><!--/--><!--$--><div data-hk=\"01105\" class=\"k2b-slider__value\" data-changed=\"true\"><!--$--><button data-hk=\"011060000\" aria-describedby=\"contrast-label\" title=\"Reset to 0\" aria-label=\"Reset to 0\" type=\"button\" class=\"k2b-button k2b-icon-button k2b-slider__reset \" data-size=\"xs\" data-variant=\"ghost\" ><span class=\"k2b-button__label\"><i data-hk=\"011060001\" class=\"ti ti-arrow-back-up\" aria-hidden=\"true\"></i></span><!--$--><!--/--></button><span data-hk=\"01106000301\" id=\"k2b-tooltip-01106000300\" role=\"tooltip\" popover=\"manual\" class=\"k2b-tooltip\">Reset to 0</span><!--/--><!--$--><output data-hk=\"0110700\" for=\"contrast\">20</output><!--/--></div><!--/--></div><!--/--><!--$--><!--/--><!--$--><div data-hk=\"013\" class=\"k2b-slider\" data-changed=\"true\" data-value-placement=\"label\"><input id=\"contrast\" type=\"range\" value=\"20\" style=\"background:linear-gradient(to right, var(--k2b-action) 0 20%, var(--k2b-surface-muted) 20% 100%)\" aria-labelledby=\"contrast-label\" /><!--$--><!--/--></div><!--/--><!--$--><!--/--></div>"
