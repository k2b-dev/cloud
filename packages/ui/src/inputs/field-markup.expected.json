  "select without label": "<div data-hk=\"010\" class=\"k2b-field \"><!--$--><!--/--><!--$--><!--/--><!--$--><div data-hk=\"013\" class=\"k2b-choice-control\" data-appearance=\"field\"><button id=\"account2\" type=\"button\" class=\"k2b-choice-trigger \" role=\"combobox\" aria-haspopup=\"listbox\" aria-expanded=\"false\" aria-controls=\"account2-listbox\" aria-label=\"Account\" ><!--$--><!--/--><span class=\"k2b-choice-trigger__value\">3400 Goods received</span><i class=\"ti ti-chevron-down k2b-choice-trigger__chevron\" aria-hidden=\"true\"></i></button><!--$--><!--/--><!--$--><!--/--><div popover=\"manual\" class=\"k2b-choice-popover\" role=\"group\" aria-label=\"Account\"><!--$--><!--/--><!--$--><!--/--><div id=\"account2-listbox\" class=\"k2b-choice-options\" role=\"listbox\" data-view=\"list\"><!--$--><!--/--><!--$--><!--/--><!--$--><button data-hk=\"01a110\" type=\"button\" id=\"account2-listbox-0\" class=\"k2b-choice-option\" role=\"option\" aria-label=\"3400 Goods received\" aria-selected=\"true\"><!--$--><!--/--><span><strong>3400 Goods received</strong><!--$--><!--/--></span></button><button data-hk=\"01a112\" type=\"button\" id=\"account2-listbox-1\" class=\"k2b-choice-option\" role=\"option\" aria-label=\"3300 Goods received, reduced rate\" aria-selected=\"false\"><!--$--><!--/--><span><strong>3300 Goods received, reduced rate</strong><!--$--><!--/--></span></button><!--/--></div></div></div><!--/--><!--$--><!--/--></div>",
