{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "outDir": "./dist/types",
    "rootDir": "./src"
  },
  "include": ["./src/**/*.ts", "./src/**/*.tsx"],
  "exclude": [
    "./dist",
    "./node_modules",
    "./src/**/*.test.ts",
    "./src/**/*.test.tsx",
    "./src/**/*.typecheck.ts",
    "./src/styles/css-contract-test-helpers.ts",
    "./src/charts/parity.ts"
  ]
}
