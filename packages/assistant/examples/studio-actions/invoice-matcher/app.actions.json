{
  "actions": [
    {
      "name": "linkTransaction",
      "title": "Link the explicitly selected invoice to a transaction",
      "description": "Link the explicitly selected invoice to a transaction",
      "entry": "link.js",
      "inputSchema": {
        "type": "object",
        "properties": {
          "transactionKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "invoicePath": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "required": [
          "transactionKey",
          "invoicePath"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "linked": {
            "type": "boolean"
          },
          "unchanged": {
            "type": "boolean"
          }
        },
        "required": [
          "linked",
          "unchanged"
        ],
        "additionalProperties": false
      }
    }
  ]
}
