# Known draggable edges without the shared grip (K13), one per occurrence: <file> | <separator|cursor> | <detail>.
# Lanes remove lines as they move an edge onto ResizeSeparator; the rule never adds lines.
# `bun scripts/check.ts resize-grips --fix` removes lines whose finding is gone.
packages/cloud/src/styles/panel.css | cursor | .cloud-panel__shield col-resize
packages/cloud/src/styles/utilities-navigation.css | cursor | .workspace-resize-handle col-resize
packages/cloud/src/styles/utilities-navigation.css | cursor | .workspace-resize-handle-drawer row-resize
packages/ui/src/layout/AppWorkspace.tsx | separator | <button class="k2b-app-workspace__resize">
packages/ui/src/layout/Panes.tsx | separator | <button class="k2b-panes__separator">
packages/ui/src/styles/index.css | cursor | .k2b-ui .k2b-panes__separator[data-direction="horizontal"] col-resize
packages/ui/src/styles/index.css | cursor | .k2b-ui .k2b-panes__separator[data-direction="vertical"] row-resize
packages/ui/src/styles/layout-parity.css | cursor | .k2b-ui .k2b-app-workspace__resize col-resize
packages/ui/src/styles/layout-parity.css | cursor | .k2b-ui .k2b-app-workspace__resize[data-app-workspace-resize="drawer"] row-resize
