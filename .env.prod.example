# Companion file to compose.prod.yml. Copy to .env and fill in.

# Immutable tag from a successful full Docker release-set job.
CLOUD_IMAGE_TAG=sha-0123456789ab

# Postgres credentials. Used by every app's DATABASE_URL and by the
# postgres service you define alongside this compose file.
POSTGRES_USER=cloud
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cloud

# Deployment-wide settings/credential encryption secret.
APP_SECRET=change-me
# Core-only KEK — generate with: openssl rand -hex 32
CLOUD_IDENTITY_KEY_ENCRYPTION_KEY=change-me-generate-with-openssl-rand-hex-32
CLOUD_IDENTITY_NEXT_KEY=
# Temporary old KEK used only while rewrapping stored identity signing keys.
CLOUD_IDENTITY_PREVIOUS_KEY=

# One-time values created through the admin identity workload-credential API.
# Keep each credential app-bound and scoped; never reuse one between apps.
CLOUD_OAUTH_APP_CREDENTIAL=
CLOUD_MAIL_APP_CREDENTIAL=
# Enable only after the corresponding credential and Core authority are live.
CLOUD_OAUTH_ISSUANCE_MODE=legacy
CLOUD_MAIL_AUTOMATION_AUTHORITY_MODE=legacy

# Public hostname routed by Traefik to the gateway.
CLOUD_HOST=cloud.example.com
