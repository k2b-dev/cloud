# Generated by `bun scripts/generate-config-docs.ts` from the environment registries. Do not edit by hand.
#
# Host-run development reference: select variables for each process separately.
# Do not load this entire file into every app: only Core receives the identity
# KEKs. Only Core and OAuth receive the OAuth broker secret; background apps
# receive only their own workload credential.
# The Docker development stack already provides its local defaults in
# compose.dev.yml and does not require copying this file to .env.
# Empty values are treated as unset. Commented keys are optional.

# ======================================================================
# Platform (packages/cloud/src/config/env.ts)
# ======================================================================

# Release images set `production`; `development` enables development-only behavior such as insecure cookies and HTTP issuers.
# NODE_ENV=

# Container or host name; the default instance identity in worker leases and gateway registration.
# HOSTNAME=

# Postgres connection read by Bun SQL and by application-owned pools.
DATABASE_URL=postgresql://ipa:ipa@localhost:5432/ipa

# Valkey connection used by Bun Redis for caches and rate limits. Aliases: VALKEY_URL.
REDIS_URL=redis://localhost:6379

# Comma-separated NATS JetStream bootstrap servers; the client dials all of them.
NATS_SERVERS=nats://localhost:4222

# Sync namespace shared by every app of one installation; isolates its NATS resources from other installations on the same cluster.
SYNC_NAMESPACE=dev

# Persistent JetStream replica count (1, 3 or 5); keep it consistent across the installation and migrate existing resources before changing it.
SYNC_REPLICAS=1

# Path to a mounted NATS `.creds` file (JWT and NKey); unset means server-side no-auth.
# NATS_CREDS_FILE=

# Path to a mounted CA certificate that enables TLS to NATS; unset means plain TCP.
# NATS_TLS_CA_FILE=

# Only dial the listed servers and ignore cluster-advertised peer addresses; set to `false` when every advertised address is reachable.
NATS_IGNORE_CLUSTER_UPDATES=true

# Public Cloud URL used to bootstrap the `app.url` setting; the stored setting wins once written.
APP_URL=localhost:3000

# Deployment-wide secret for at-rest settings encryption and signed cursors; generate once with `openssl rand -hex 32` and never change it after data has been written.
APP_SECRET=change-me-generate-with-openssl-rand-hex-32

# Core only: temporary first-administrator or recovery login token; remove it after normal administrator sign-in works.
# ADMIN_LOGIN_TOKEN=

# Core only: 64-hex KEK for platform identity signing keys stored in Postgres; generate once with `openssl rand -hex 32` and never distribute it to other apps.
CLOUD_IDENTITY_KEY_ENCRYPTION_KEY=change-me-generate-with-openssl-rand-hex-32

# Core only: pre-distributed next KEK before promoting it to current; cannot be combined with `CLOUD_IDENTITY_PREVIOUS_KEY`.
# CLOUD_IDENTITY_NEXT_KEY=

# Core only: old KEK set during an explicit rolling rewrap of stored identity signing keys, then removed.
# CLOUD_IDENTITY_PREVIOUS_KEY=

# Core and OAuth only: 64-hex secret that lets the OAuth app request token signatures from Core; generate independently with `openssl rand -hex 32`.
# CLOUD_OAUTH_BROKER_SECRET=

# Direct Core listener origin for OAuth issuance, mandate-backed background work and internal callbacks; host-run callers use the Core port, not the gateway.
# CLOUD_CORE_INTERNAL_ORIGIN=

# App-bound workload credential provisioned through Core's admin workload API; background apps such as Mail need one with `identity:invoke`.
# CLOUD_APP_CREDENTIAL=

# Optional private origin of the Core listener for session and invocation JWKS; unset fetches keys from the public issuer origin.
# CLOUD_IDENTITY_JWKS_ORIGIN=

# Optional private origin of the OAuth listener for OAuth JWKS; unset fetches keys from the public issuer origin.
# CLOUD_OAUTH_JWKS_ORIGIN=

# Application directory for standalone consumers running `@k2b/cloud/scripts/build.ts` or the SSR dev server outside the monorepo; defaults to the package directory.
# APP_DIR=

# SQLite file used by `desktop.sql` in the Bun desktop process; defaults to `.local/desktop.sqlite` in the working directory.
# CLOUD_DESKTOP_SQLITE_PATH=
# ======================================================================
# assistant (packages/assistant/src/env.ts)
# ======================================================================

# Path to a Chromium executable for Assistant code mode when Playwright's bundled browser is unavailable; the assistant image sets `/usr/bin/chromium`.
# CLOUD_CLI_CHROMIUM=
# ======================================================================
# gateway-ops (packages/gateway-ops/src/env.ts)
# ======================================================================

# Optional comma-separated NATS system-account servers used only for Gateway Ops cluster diagnostics.
# NATS_ADMIN_SERVERS=

# Path to the mounted system-account `.creds` file for NATS diagnostics; do not combine with the NKey seed file.
# NATS_ADMIN_CREDS_FILE=

# Path to a static system-account NKey seed file for NATS diagnostics; an alternative to the `.creds` file.
# NATS_ADMIN_NKEY_SEED_FILE=

# Path to the CA certificate that enables TLS for the NATS diagnostics connection.
# NATS_ADMIN_TLS_CA_FILE=
# ======================================================================
# gateway (packages/gateway/src/env.ts)
# ======================================================================

# Stable identity of this gateway router instance in the registry; defaults to `HOSTNAME`, then `gateway-router`.
# GATEWAY_INSTANCE_ID=
# ======================================================================
# pwa-auth (pwas/pwa-auth/server/env.ts)
# ======================================================================

# Cloud Login only: VAPID public key for sign-in push notifications; generate the pair once with `bunx web-push generate-vapid-keys`. Unset disables push.
# CLOUD_LOGIN_VAPID_PUBLIC_KEY=

# Cloud Login only: VAPID private key matching `CLOUD_LOGIN_VAPID_PUBLIC_KEY`; changing it invalidates every phone's push subscription.
# CLOUD_LOGIN_VAPID_PRIVATE_KEY=

# Cloud Login only: operator contact sent to push services, as `mailto:` or `https://` URL.
# CLOUD_LOGIN_VAPID_SUBJECT=

# ======================================================================
# Docker Compose inputs (interpolated by compose files, not read by Cloud processes)
# ======================================================================

# Development only: loopback host port for NATS; host-run processes and CLOUD_TEST_NATS_SERVERS must use the same port.
# CLOUD_DEV_NATS_PORT=4222

# Development only: loopback host port for Postgres; host-run processes and CLOUD_TEST_DATABASE_URL must use the same port.
# CLOUD_DEV_POSTGRES_PORT=5432

# Development only: loopback host port for Valkey; host-run processes and CLOUD_TEST_VALKEY_URL must use the same port.
# CLOUD_DEV_VALKEY_PORT=6379

# Mail only: Compose passes this workload credential to Mail as CLOUD_APP_CREDENTIAL.
CLOUD_MAIL_APP_CREDENTIAL=
