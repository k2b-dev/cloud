              "blocks": [
                {
                  "id": "meine-intro",
                  "type": "markdown",
                  "markdown": "# Meine Erstattungen\nAntrag anlegen, Ausgaben ergänzen und Belege hochladen. Du siehst hier nur deine eigenen Erstattungen.\n\n**Private Demo:** Fiktive Daten, keine Bankanbindung. Für den Funktionstest übernimmst du momentan alle Rollen; dies ist noch keine Abnahme der personellen Funktionstrennung."
                },
                {
                  "id": "meine-list",
                  "type": "records",
                  "source": {
                    "kind": "gql",
                    "query": "from table {csW4Zu} as claim\njoin table {AuCwGm} as cost on {L2x8Za} = cost.id\nselect {JzxN6G}, {L2x8Za}, {BjF4AG}, {658Cqp}, {TcBFvJ}, {533ZJT}\nwhere oneof({QFMSK7}, @auth.id)\nsort {JzxN6G} asc"
                  },
                  "display": {
                    "kind": "table",
                    "columnIds": []
                  },
                  "emptyText": "Hier gibt es derzeit keine Anträge.",
                  "rowNavigate": {
                    "kind": "navigate",
                    "pageId": "antrag",
                    "params": {
                      "request_id": {
                        "source": "ROW",
                        "path": "id"
                      }
                    }
                  }
                }
              ]
            }
          ]
        }
      ]
