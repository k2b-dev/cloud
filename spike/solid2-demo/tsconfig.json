{
  "compilerOptions": {
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "bundler",
    "customConditions": ["solid"],
    "jsx": "preserve",
    "jsxImportSource": "@solidjs/web",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "types": ["bun"],
    "paths": {
      "@k2b/ssr": ["../../packages/ssr/src/index.ts"],
      "@k2b/ssr/hono": ["../../packages/ssr/src/adapter/hono.ts"],
      "@k2b/ui/v2": ["../../packages/ui/src/v2/index.ts"],
      "@k2b/ui/v2/*": ["../../packages/ui/src/v2/*"]
    }
  },
  "include": ["src/**/*", "scripts/**/*", "test/**/*", "../../packages/ui/src/v2/**/*"]
}
